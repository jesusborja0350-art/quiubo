# Copia este archivo a .env y ajusta los valores. Nunca subas .env a GitHub.
PORT=3000
# Archivo de la base de datos SQLite. En producción apúntalo a un disco persistente (por ejemplo /data/quiubo.db).
DB_PATH=./data/quiubo.db
# Clave para ver los reportes en /api/admin/reportes (cabecera x-admin-token). Déjala vacía para desactivar el panel.
ADMIN_TOKEN=
# Pon 1 si el servidor está detrás de un proxy (Render, Railway, Fly, Nginx) para leer la IP real y limitar abusos.
TRUST_PROXY=0
# En producción con HTTPS: NODE_ENV=production activa las cookies "Secure".
NODE_ENV=development
